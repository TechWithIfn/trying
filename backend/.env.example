# Downloadit backend — complete supported environment configuration.
# Copy values (not secrets) into your hosting provider's server-side env settings.
# NEVER commit real credentials. NEVER prefix secrets with NEXT_PUBLIC_.

# ---------------------------------------------------------------- Server
PORT=3001
NODE_ENV=production

# ---------------------------------------------------------------- CORS
# Exact frontend origin (protocol + host, no trailing slash). Comma-separated
# list allowed. Unset = same-origin only (browser cross-origin calls fail).
CORS_ORIGIN=https://yourdomain.com
# Only "true"/"1" when behind a proxy that rewrites forwarding headers.
# Vercel is trusted automatically unless TRUST_PROXY=false/0.
TRUST_PROXY=
# Proxy hop count used only when TRUST_PROXY is enabled.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------- Resolver / provider
# Options: placeholder (safe default: resolves nothing), mock (dev/test only,
# never production), external (needs PROVIDER_API_URL + PROVIDER_API_KEY),
# puppeteer (headless browser; needs nothing else).
RESOLVER_PROVIDER=placeholder
# External resolver API (external provider ONLY — not required for puppeteer).
PROVIDER_API_URL=
PROVIDER_API_KEY=
# Max distinct URLs resolving simultaneously (overflow → 503, never unbounded).
MAX_INFLIGHT_RESOLUTIONS=64
# Resolved-metadata cache: TTL ms + max entries.
RESOLVE_CACHE_TTL_MS=120000
RESOLVE_CACHE_MAX_ENTRIES=200

# ---------------------------------------------------------------- Instagram session (server-side ONLY)
# Anonymous resolution works from residential IPs, but datacenter-hosted
# backends (Vercel/Railway/Render/VPS) receive video-stripped pages and every
# Reel fails with VIDEO_SOURCE_NOT_FOUND. A viewer session restores the full
# media document. Set ONE of these (first non-empty wins):
#   full cookie string:  INSTAGRAM_COOKIE="sessionid=...; csrftoken=...; ..."
#   bare session id:     INSTAGRAM_SESSIONID="<sessionid>" (wrapped automatically)
# Supported names (checked in order):
#   INSTAGRAM_COOKIE, IG_COOKIE, INSTAGRAM_COOKIE_STRING, INSTAGRAM_SESSION_COOKIE,
#   INSTAGRAM_SESSIONID, IG_SESSIONID, INSTAGRAM_SESSION_ID, SESSIONID
# NEVER commit a real value. NEVER expose via frontend/logs/API/health.
INSTAGRAM_COOKIE=
INSTAGRAM_SESSIONID=

# ---------------------------------------------------------------- Puppeteer
# Runtime: "local" | "serverless" (unset = auto-detect via VERCEL env).
PUPPETEER_RUNTIME=
# Hard per-resolve browser deadline ms (bounded 5000-300000).
PUPPETEER_RESOLVE_DEADLINE_MS=45000
# Page-slot queue wait ms (0 = fail fast with 503 instead of queueing).
PUPPETEER_QUEUE_WAIT_MS=8000
# Idle browser teardown ms (0/disabled handling per code; min 10000).
PUPPETEER_BROWSER_IDLE_TTL_MS=120000
# Bounded video-graph settle (hydration) budget ms (500-30000, never raised blindly).
PUPPETEER_VIDEO_SETTLE_MS=12000

# ---------------------------------------------------------------- Timeouts
# Route-level resolve guard ms (safe fallback when malformed).
RESOLVER_TIMEOUT_MS=15000
# Retry-After seconds advertised on 503 capacity responses.
CAPACITY_RETRY_AFTER_SECONDS=3
# Graceful shutdown: drain + per-step cleanup budgets ms.
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
SHUTDOWN_CLEANUP_TIMEOUT_MS=8000
# Transient retry policy (attempts, base and max backoff ms).
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=250
RETRY_MAX_DELAY_MS=2000
# Best-effort media enrichment probe timeout ms (safe fallback when malformed).
MEDIA_PROBE_TIMEOUT_MS=5000

# ---------------------------------------------------------------- Rate limiting (per IP, per endpoint)
# Shared window ms + default budget (resolve = 17/min).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=17
# Endpoint-specific budgets (same window).
RATE_LIMIT_DOWNLOAD_MAX_REQUESTS=60
RATE_LIMIT_STREAM_MAX_REQUESTS=180
RATE_LIMIT_AUDIO_MAX_REQUESTS=20
# Memory cap for tracked rate-limit keys.
RATE_LIMIT_MAX_TRACKED_KEYS=20000
# Concurrent same-IP slots (overflow → 503 + Retry-After, never silent).
MAX_CONCURRENT_RESOLVES_PER_IP=2
MAX_CONCURRENT_DOWNLOADS_PER_IP=2
MAX_CONCURRENT_STREAMS_PER_IP=3
MAX_CONCURRENT_AUDIO_PER_IP=1

# ---------------------------------------------------------------- Temporary result storage
# Resolved-media entry TTL ms + active-use guard ms (downloads never delete).
TEMP_STORE_TTL_MS=600000
TEMP_STORE_ACTIVE_GUARD_MS=60000

# ---------------------------------------------------------------- Streaming / media proxy diagnostics
# MEDIA_DIAG=1 logs upstream status/content-type/host (never query/tokens).
MEDIA_DIAG=

# ---------------------------------------------------------------- Audio / FFmpeg
# Dedicated audio provider (server-side only). When unset, audio pages fall
# back to page-based lookup with clear errors.
AUDIO_PROVIDER_URL=
AUDIO_PROVIDER_KEY=

# ---------------------------------------------------------------- Resolver worker pool (3-worker load manager)
# Incoming resolves are routed to the least-loaded healthy worker. Defaults
# are sized from the existing proven budget: 3 workers x 2 concurrent browser
# jobs = 6 simultaneous resolves, exactly the MAX_CONCURRENT_PAGES default
# (each Chromium page holds hundreds of MB — do not raise blindly).
# WORKER_COUNT=3
# WORKER_MAX_CONCURRENCY=2
# Per-worker bounded FIFO queue (waiting jobs); 0 = fail fast with 503.
# WORKER_MAX_QUEUE_SIZE=4
# Prefer workers below this load % (0-100 from real active+queued work);
# when all workers are above it, the least-loaded one still wins.
# WORKER_LOAD_THRESHOLD=85
# Execution bound per job (defaults to RESOLVER_TIMEOUT_MS). Protects callers
# with no route-level timeout (audio extraction, stale-URL refresh).
# WORKER_JOB_TIMEOUT_MS=15000
# How long a job may wait for a worker slot before a controlled 503.
# WORKER_QUEUE_WAIT_MS=8000
# Crash cooldown (browser transport lost): base, doubling per consecutive
# failure up to WORKER_MAX_RECOVER_MS. No process is ever spawned, so there
# is no restart loop to bound — recovery is re-admission after cooldown.
# WORKER_RECOVER_COOLDOWN_MS=10000
# WORKER_MAX_RECOVER_MS=60000
# WORKER_MAX_CONSECUTIVE_FAILURES=5
# Stale-slot sweep for wedged jobs (defaults to 4x the job timeout).
# WORKER_STALE_MS=

# ---------------------------------------------------------------- Concurrency (global gates; advanced)
# Pattern per workload (request/resolve/provider/puppeteer/audio/ffmpeg/
# stream/download/probe): MAX_CONCURRENT_<X>, <X>_QUEUE_WAIT_MS, <X>_STALE_MS.
# Examples (defaults apply when unset — change only with measured reason):
# MAX_CONCURRENT_REQUESTS=256
# MAX_CONCURRENT_RESOLVES=64
# MAX_CONCURRENT_PROVIDERS=24
# MAX_CONCURRENT_PAGES=6
# MAX_CONCURRENT_AUDIO_JOBS=4
# MAX_CONCURRENT_FFMPEG=2
# MAX_CONCURRENT_STREAMS=128
# MAX_CONCURRENT_DOWNLOADS=64
# MAX_CONCURRENT_PROBES=12
# Enrichment fan-out caps.
MAX_PROBES_PER_BATCH=4
MAX_PROBE_ITEMS_PER_BATCH=12

# ---------------------------------------------------------------- Security
# Max JSON body bytes (resolve/audio POSTs).
MAX_REQUEST_BODY_SIZE=1024

# ---------------------------------------------------------------- Production / runtime
# Build identifier surfaced by GET /api/health/ready (proves deployed code).
# Vercel auto-provides VERCEL_GIT_COMMIT_SHA; set BUILD_VERSION otherwise.
BUILD_VERSION=
# Background sweeps are disabled automatically on Vercel; set
# DISABLE_BACKGROUND_TIMERS=true only for exotic runtimes.
DISABLE_BACKGROUND_TIMERS=
# Dev/test only: ALLOW_MOCK_CDN=true admits mock-cdn.example.com. NEVER in prod.
ALLOW_MOCK_CDN=
