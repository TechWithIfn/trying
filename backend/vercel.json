{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.ts": {
      "memory": 2048,
      "maxDuration": 300,
      "includeFiles": "bin/**",
      "excludeFiles": "node_modules/youtube-dl-exec/bin/**"
    }
  }
}
