# Instagram Highlight Downloader - Server-side session (NEVER commit real values, NEVER expose to frontend)
# Copy your logged-in Instagram cookies from browser DevTools > Application > Cookies > instagram.com
# Required for Highlights/Stories that Instagram gates behind login (even public highlights need session)
# This file is loaded server-side only via backend/src/server.ts

# Full cookie string (recommended) - copy as "Cookie:" header value
INSTAGRAM_COOKIE="sessionid=PASTE_HERE; csrftoken=PASTE_HERE; ds_user_id=PASTE_HERE"
# Example real: sessionid=1234567890%3Aabc...; csrftoken=XYZ...; ds_user_id=12345678; mid=...; ig_did=...

# Alternative: individual values (also supported)
# INSTAGRAM_SESSIONID=
# IG_COOKIE=

# Instagram App ID (default 936619743392459 is used if not set)
# X_IG_APP_ID=936619743392459

# =============================================================================
# CAPACITY / CONCURRENCY (per instance)
# =============================================================================
# Every value is bounded: an invalid value falls back to the default, and an
# absurdly large one is CLAMPED (e.g. MAX_CONCURRENT_PAGES is capped at 4096).
# Nothing here may be left unlimited: each workload has a hard ceiling and a
# bounded queue, and a saturated workload returns HTTP 503 with Retry-After
# instead of consuming more memory/CPU.
#
# When tuning for your own instance, raise one limit at a time and watch
# GET /api/health/capacity (utilization, queued, rejected, reclaimed) plus
# RSS/heap. Size limits to the SMALLEST instance in the fleet, not the average.

# Total in-flight HTTP requests (all routes).
# MAX_CONCURRENT_REQUESTS=256
# REQUEST_QUEUE_WAIT_MS=1000
# REQUEST_STALE_MS=120000

# /api/resolve handlers (validation stays cheap and is NOT gated by this).
# MAX_CONCURRENT_RESOLVES=64
# RESOLVE_QUEUE_WAIT_MS=5000
# RESOLVE_STALE_MS=90000
# Per client:
# MAX_CONCURRENT_RESOLVES_PER_IP=2

# Provider.resolve() calls (Puppeteer / external / mock).
# MAX_CONCURRENT_PROVIDERS=24
# PROVIDER_QUEUE_WAIT_MS=5000
# PROVIDER_STALE_MS=60000

# Concurrent Chromium pages. Each page is a real tab with its own memory.
# Raise only after measuring RSS; this is the usual cause of OOM kills.
# MAX_CONCURRENT_PAGES=6
# PUPPETEER_QUEUE_WAIT_MS=8000
# PUPPETEER_STALE_MS=60000
# Hard ceiling for a single provider resolve (a hung page cannot pin a slot).
# PUPPETEER_RESOLVE_DEADLINE_MS=45000
# Close an idle browser after this long instead of holding the process.
# PUPPETEER_BROWSER_IDLE_TTL_MS=300000

# Audio requests doing resolve + download + transcode.
# MAX_CONCURRENT_AUDIO_JOBS=4
# AUDIO_QUEUE_WAIT_MS=2000
# AUDIO_STALE_MS=120000
# MAX_CONCURRENT_AUDIO_PER_IP=1

# FFmpeg child processes: the single most CPU/memory hungry operation.
# MAX_CONCURRENT_FFMPEG=2
# FFMPEG_QUEUE_WAIT_MS=2000
# FFMPEG_STALE_MS=90000

# Media streams proxied to clients (video playback / range requests).
# MAX_CONCURRENT_STREAMS=128
# STREAM_QUEUE_WAIT_MS=2000
# STREAM_STALE_MS=300000
# A browser opens several range requests per video, so this is > 1.
# MAX_CONCURRENT_STREAMS_PER_IP=3

# File downloads proxied to clients.
# MAX_CONCURRENT_DOWNLOADS=64
# DOWNLOAD_QUEUE_WAIT_MS=2000
# DOWNLOAD_STALE_MS=300000
# MAX_CONCURRENT_DOWNLOADS_PER_IP=2

# Metadata probes issued while enriching resolved media (HEAD + ranged GET).
# MAX_CONCURRENT_PROBES=12
# PROBE_QUEUE_WAIT_MS=3000
# PROBE_STALE_MS=30000
# MAX_PROBES_PER_BATCH=4
# MAX_PROBE_ITEMS_PER_BATCH=12

# Maximum distinct URLs being resolved at once (dedupes concurrent identical
# requests; excess gets a clean 503 instead of a second browser launch).
# MAX_INFLIGHT_RESOLUTIONS=64

# Retry-After header (seconds) sent with capacity 503 responses.
# CAPACITY_RETRY_AFTER_SECONDS=3

# =============================================================================
# RESOLVE CACHE
# =============================================================================
# An invalid value previously produced NaN, which silently disabled expiry.
# RESOLVE_CACHE_TTL_MS=120000
# RESOLVE_CACHE_MAX_ENTRIES=200

# =============================================================================
# RATE LIMITING
# =============================================================================
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_DOWNLOAD_MAX_REQUESTS=60
# RATE_LIMIT_STREAM_MAX_REQUESTS=180
# RATE_LIMIT_AUDIO_MAX_REQUESTS=20
# Hard cap on tracked client buckets (protects memory when IPs rotate).
# RATE_LIMIT_MAX_TRACKED_KEYS=20000

# =============================================================================
# TRUSTED PROXY / CLIENT IP
# =============================================================================
# Leave TRUST_PROXY unset when the app is exposed directly: X-Forwarded-For is
# then ignored, because otherwise any client could spoof its IP and bypass both
# rate limits and per-client concurrency limits.
# Set to 1 (or a number of hops) ONLY behind a proxy you control that sets and
# overwrites X-Forwarded-For.
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1

# =============================================================================
# BACKGROUND MAINTENANCE TIMERS
# =============================================================================
# Cache/rate-limit/temp-dir sweeps are named, unref'd timers that are cleared on
# shutdown. They are disabled automatically on Vercel (no long-lived process).
# DISABLE_BACKGROUND_TIMERS=false

# =============================================================================
# GRACEFUL SHUTDOWN
# =============================================================================
# On SIGTERM the server stops accepting work, reports 503 on readiness, drains
# in-flight requests (bounded), then closes Chromium and clears timers.
# SHUTDOWN_DRAIN_TIMEOUT_MS=10000
# SHUTDOWN_CLEANUP_TIMEOUT_MS=8000

# =============================================================================
# TEMP RESOLUTION STORE
# =============================================================================
# Resolutions live in memory (hard-capped at 1000 entries) and expire by TTL.
# Entries read within the guard window are protected from LRU eviction, so a
# download in progress is never pulled out from under itself.
# TEMP_STORE_TTL_MS=600000
# TEMP_STORE_ACTIVE_GUARD_MS=60000

# =============================================================================
# TRANSIENT RETRY
# =============================================================================
# Only transient transport failures are retried, with full jitter. Timeouts are
# never retried (the caller budget is already spent) and nothing retries
# forever. Currently applied to the post-refresh upstream fetch.
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_MS=250
# RETRY_MAX_DELAY_MS=2000

# =============================================================================
# PROVIDER / MISC
# =============================================================================
# RESOLVER_PROVIDER=puppeteer
# RESOLVER_TIMEOUT_MS=15000
# CORS_ORIGIN=https://downloadit.pro
# AUDIO_PROVIDER_URL=
# AUDIO_PROVIDER_KEY=
